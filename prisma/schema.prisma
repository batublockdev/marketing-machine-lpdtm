generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Post {
  id              String      @id @default(uuid())
  botId           String
  platform        String
  targetAccount   String?
  videoPath       String
  mediaFiles      String?
  caption         String?
  tags            String?
  status          String      @default("pending")
  rejectReason    String?

  // Legacy fields (keep for backward compatibility)
  platformPostId  String?
  publishedUrl    String?
  views           Int         @default(0)
  likes           Int         @default(0)
  shares          Int         @default(0)
  comments        Int         @default(0)
  publishedAt     DateTime?
  statsUpdatedAt  DateTime?

  // New TikTok fields
  tiktokPublished     Boolean   @default(false)
  tiktokPostId        String?
  tiktokUrl           String?
  tiktokPublishedAt   DateTime?

  // New Instagram fields
  instagramPublished      Boolean   @default(false)
  instagramPostId         String?
  instagramUrl           String?
  instagramPublishedAt   DateTime?
  instagramPublishReady  Boolean   @default(false)

  // Timestamps
  createdAt       DateTime    @default(now())
  approvedAt      DateTime?
  rejectedAt      DateTime?

  @@index([botId])
  @@index([platform])
  @@index([status])
  @@index([tiktokPublished])
  @@index([instagramPublished])
  @@index([instagramPublishReady])
}

model TikTokToken {
  id            String   @id @default(uuid())
  openId        String   @unique
  accessToken   String
  refreshToken  String
  expiresIn     Int
  scope         String
  obtainedAt    DateTime @default(now())
  updatedAt     DateTime @default(now())

  @@index([openId])
}

model Stats {
  id          String   @id @default(uuid())
  botId       String
  platform    String
  posts       Int      @default(0)
  views       Int      @default(0)
  likes       Int      @default(0)
  shares      Int      @default(0)
  comments    Int      @default(0)
  updatedAt   DateTime  @default(now())

  @@unique([botId, platform])
}